# Configure these in the environment used to start Node; this app does not auto-load .env.
# Keep secrets out of public/ and source control.
PUBLIC_URL=
DATABASE_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
RATE_LIMIT_SECRET=
PAYSTACK_SECRET_KEY=
# Set 1 on your HTTPS production deployment.
COOKIE_SECURE=0
# Optional: only behind a trusted proxy that strips/overwrites this header.
TRUSTED_COUNTRY_HEADER=

# Google OAuth Web client; callback is PUBLIC_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
